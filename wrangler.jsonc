/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chatbot",
	"main": "src/index.js",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "ai"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "profile-vectors"
		}
	],
	"d1_databases": [
		{
			"binding": "chatbot_logs",
			"database_name": "chatbot-logs",
			"database_id": "03cf483c-249f-4654-be96-6918ec2b4b8a"
		}
	],
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": {
					"limit": 30,
					"period": 86400
				}
			}
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_SESSION",
				"class_name": "ChatSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ChatSession"
			]
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"ALLOWED_ORIGINS": "https://cloudflare-page-wjy.pages.dev,https://abraham.dpdns.org"
	}
}